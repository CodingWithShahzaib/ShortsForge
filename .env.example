OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GROQ_API_KEY=
OPENROUTER_API_KEY=
ELEVENLABS_API_KEY=
REPLICATE_API_KEY=
FAL_API_KEY=
TOGETHER_API_KEY=
RUNWARE_API_KEY=
DATABASE_URL=postgresql+asyncpg://shortsforge:shortsforge_password@localhost:5432/shortsforge
# SQLite example:
# DATABASE_URL=sqlite+aiosqlite:///./shortsforge.db
# MySQL example (requires async driver like asyncmy):
# DATABASE_URL=mysql+asyncmy://user:pass@localhost:3306/shortsforge
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
REDIS_URL=redis://localhost:6379/0

STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=shortsforge
S3_REGION=us-east-1
S3_SECURE=false
S3_PRESIGN_EXPIRES=3600

MEDIA_DIR=./media
FFMPEG_PATH=ffmpeg
